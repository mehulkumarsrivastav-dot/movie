rules_version = '2';

/**
 * Movie Night — Firestore Security Rules
 *
 * This is the REAL access-control boundary for the app (not the frontend
 * VITE_ALLOWED_USERS_HINT, which is only a client-side UX shortcut).
 *
 * Model:
 *  - allowlist/config           { emails: string[] }   -- the two approved people
 *  - users/{uid}                 profile, owner-writable only
 *  - roomCodes/{code}            { roomId }             -- lookup index, readable by allowed users
 *  - rooms/{roomId}               room metadata, membership capped at 2
 *      /members/{uid}
 *      /messages/{messageId}
 *      /signals/{signalId}       WebRTC offer/answer/ICE signaling documents
 *      /meta/stats                movie-night counters
 *  - memories/{memoryId}          movie ratings/notes, tied to a roomId the user is a member of
 *
 * Deploy with: firebase deploy --only firestore:rules
 */
function isSignedIn() {
  return request.auth != null;
}

function isAllowedUser() {
  return isSignedIn() &&
    request.auth.token.email in get(/databases/$(database)/documents/allowlist/config).data.emails;
}

function isRoomMember(roomId) {
  return isSignedIn() &&
    request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /allowlist/config {
      // Nobody writes this from the client — manage it from the Firebase
      // console or via a trusted admin script using the Admin SDK, which
      // bypasses these rules entirely.
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser() && request.auth.uid == uid;
      allow update: if isAllowedUser() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /roomCodes/{code} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser();
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if isAllowedUser() && request.auth.uid in resource.data.memberUids;
      allow create: if isAllowedUser() &&
        request.resource.data.memberUids.size() == 1 &&
        request.auth.uid in request.resource.data.memberUids;
      // Joining: only allowed to append yourself, and only while under the 2-person cap.
      allow update: if isAllowedUser() && request.auth.uid in resource.data.memberUids ||
        (isAllowedUser() &&
         resource.data.memberUids.size() < 2 &&
         request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
         request.auth.uid in request.resource.data.memberUids);
      allow delete: if isAllowedUser() && request.auth.uid in resource.data.memberUids;

      match /members/{uid} {
        allow read: if isRoomMember(roomId);
        allow write: if isRoomMember(roomId) && request.auth.uid == uid;
      }

      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      match /signals/{signalId} {
        // Signaling docs are short-lived and only relevant to the two
        // participants; the sender creates them, the recipient reads/deletes.
        allow read: if isRoomMember(roomId) && resource.data.to == request.auth.uid;
        allow create: if isRoomMember(roomId) && request.resource.data.from == request.auth.uid;
        allow delete: if isRoomMember(roomId) && resource.data.to == request.auth.uid;
        allow update: if false;
      }

      match /meta/{docId} {
        allow read: if isRoomMember(roomId);
        allow write: if isRoomMember(roomId);
      }
    }

    match /memories/{memoryId} {
      allow read: if isAllowedUser() && isRoomMember(resource.data.roomId);
      allow create: if isAllowedUser() && isRoomMember(request.resource.data.roomId) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isAllowedUser() && isRoomMember(resource.data.roomId);
      allow delete: if false;
    }
  }
}
