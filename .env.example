# ============================================================================
# Movie Night — environment variables
# Copy this file to .env.local (which is gitignored) and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================================

# ---- Firebase (Project Settings > General > Your apps > Web app) ----
# These values are safe to expose in a browser bundle — Firebase's web SDK
# config is not a secret, real access control is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Access control (UX shortcut only — see firestore.rules for the real boundary) ----
# Comma-separated emails of the two people allowed to use this app. This is
# only used client-side to show an instant "not invited" screen; you MUST
# also add these emails to the `allowlist/config` document in Firestore
# (see README) or the security rules will reject them regardless.
VITE_ALLOWED_USERS_HINT=you@example.com,partner@example.com

# ---- TURN server (REQUIRED for calls to work across different networks) ----
# Without a working TURN server, calls will usually only work when both of
# you are on the same WiFi network. See README "TURN configuration" for how
# to get these from a managed provider (e.g. Twilio, Cloudflare Calls,
# Metered.ca, Xirsys) or run your own coturn instance.
# VITE_TURN_URL can be a comma-separated list, e.g.
#   turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=

# Comma-separated STUN servers. The Google public STUN server below is a
# reasonable default and does not require an account.
VITE_STUN_URLS=stun:stun.l.google.com:19302

# ---- Misc ----
# Your deployed domain, without protocol (e.g. movie-date.vercel.app).
# Only used to build the Twitch embed `parent` parameter.
VITE_APP_HOSTNAME=localhost
